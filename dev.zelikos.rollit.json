{
  "id": "dev.zelikos.rollit",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "rollit",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "modules": [
    {
      "name": "rollit",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/zelikos/rannum.git",
          "tag": "4.0.3",
          "commit": "5911a0722637eb0bdbf179f31c1bdbeb5f45d686"
        },
        "generated-sources.json",
        {
          "type": "shell",
          "commands": [
            "mkdir .cargo",
            "cp cargo/config .cargo/"
          ]
        }
      ]
    }
  ]
}
